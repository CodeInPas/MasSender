object frmCampaignsForm: TfrmCampaignsForm
  Left = 350
  Height = 504
  Top = 150
  Width = 866
  Caption = 'Campaign & Template Management'
  ClientHeight = 504
  ClientWidth = 866
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  object gbList: TGroupBox
    Left = 12
    Height = 480
    Top = 12
    Width = 280
    Align = alLeft
    BorderSpacing.Around = 12
    Caption = ' Campaign List '
    ClientHeight = 460
    ClientWidth = 276
    TabOrder = 0
    object sgCampaigns: TStringGrid
      AnchorSideBottom.Control = btnAdd
      Left = 10
      Height = 410
      Top = 10
      Width = 256
      Anchors = [akTop, akLeft, akBottom]
      BorderSpacing.Bottom = 3
      ColCount = 2
      FixedCols = 0
      Flat = True
      Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goRowSelect]
      TabOrder = 0
      OnClick = sgCampaignsClick
      ColWidths = (
        40
        212
      )
      Cells = (
        2
        0
        0
        'ID'
        1
        0
        'Campaign Name'
      )
    end
    object btnAdd: TButton
      AnchorSideBottom.Control = gbList
      AnchorSideBottom.Side = asrBottom
      Left = 10
      Height = 35
      Top = 423
      Width = 120
      Anchors = [akBottom]
      BorderSpacing.Bottom = 2
      Caption = 'Create New'
      TabOrder = 1
      OnClick = btnAddClick
    end
    object btnDelete: TButton
      AnchorSideBottom.Control = gbList
      AnchorSideBottom.Side = asrBottom
      Left = 140
      Height = 35
      Top = 423
      Width = 126
      Anchors = [akBottom]
      BorderSpacing.Bottom = 2
      Caption = 'Delete Selected'
      TabOrder = 2
      OnClick = btnDeleteClick
    end
  end
  object gbEditor: TGroupBox
    Left = 304
    Height = 480
    Top = 12
    Width = 550
    Align = alClient
    BorderSpacing.Around = 12
    Caption = ' Template Editor '
    ClientHeight = 460
    ClientWidth = 546
    TabOrder = 1
    object Label1: TLabel
      Left = 9
      Height = 15
      Top = 4
      Width = 533
      Align = alTop
      BorderSpacing.Left = 5
      BorderSpacing.Around = 4
      Caption = 'Name/Subject:'
      Font.Style = [fsBold]
      ParentFont = False
    end
    object edtName: TEdit
      Left = 9
      Height = 23
      Top = 23
      Width = 533
      Align = alTop
      BorderSpacing.Left = 5
      BorderSpacing.Around = 4
      TabOrder = 0
    end
    object Label2: TLabel
      Left = 9
      Height = 15
      Top = 50
      Width = 533
      Align = alTop
      BorderSpacing.Left = 5
      BorderSpacing.Around = 4
      Caption = 'Message Body (Text):'
      Font.Style = [fsBold]
      ParentFont = False
    end
    object lblHint: TLabel
      Left = 9
      Height = 15
      Top = 69
      Width = 533
      Align = alTop
      BorderSpacing.Left = 5
      BorderSpacing.Around = 4
      Caption = 'Tip: Use [Name] to mention the contact''s name.'
      Font.Color = clGray
      ParentFont = False
    end
    object mmoTemplate: TMemo
      AnchorSideLeft.Control = gbEditor
      AnchorSideTop.Control = lblHint
      AnchorSideTop.Side = asrBottom
      AnchorSideRight.Control = gbEditor
      AnchorSideRight.Side = asrBottom
      AnchorSideBottom.Control = btnSave
      Left = 8
      Height = 330
      Top = 90
      Width = 532
      Align = alCustom
      Anchors = [akTop, akLeft, akRight, akBottom]
      BorderSpacing.Left = 4
      BorderSpacing.Top = 2
      BorderSpacing.Right = 2
      BorderSpacing.Bottom = 1
      BorderSpacing.Around = 4
      ScrollBars = ssAutoVertical
      TabOrder = 1
    end
    object btnGenerateAi: TButton
      AnchorSideLeft.Control = gbEditor
      AnchorSideBottom.Control = gbEditor
      AnchorSideBottom.Side = asrBottom
      Left = 6
      Height = 36
      Top = 424
      Width = 150
      Anchors = [akLeft, akBottom]
      BorderSpacing.Left = 6
      Caption = 'Generate AI Spintax'
      TabOrder = 2
      OnClick = btnGenerateAiClick
    end
    object btnSave: TButton
      AnchorSideRight.Control = gbEditor
      AnchorSideRight.Side = asrBottom
      AnchorSideBottom.Control = gbEditor
      AnchorSideBottom.Side = asrBottom
      Left = 396
      Height = 35
      Top = 425
      Width = 150
      Anchors = [akRight, akBottom]
      Caption = 'Save Campaign'
      TabOrder = 3
      OnClick = btnSaveClick
    end
  end
end
