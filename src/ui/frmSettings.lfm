object frmSettingsForm: TfrmSettingsForm
  Left = 350
  Height = 453
  Top = 150
  Width = 753
  Caption = 'System & SMTP Settings'
  ClientHeight = 453
  ClientWidth = 753
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  object gbAppConfig: TGroupBox
    Left = 6
    Height = 100
    Top = 6
    Width = 741
    Align = alTop
    BorderSpacing.Around = 6
    Caption = ' Application Settings '
    ClientHeight = 80
    ClientWidth = 737
    TabOrder = 0
    object Label1: TLabel
      Left = 15
      Height = 15
      Top = 15
      Width = 99
      Caption = 'Web Tracking URL:'
    end
    object edtTrackingUrl: TEdit
      Left = 130
      Height = 23
      Top = 12
      Width = 400
      TabOrder = 0
    end
    object Label2: TLabel
      Left = 15
      Height = 15
      Top = 45
      Width = 70
      Caption = 'Max Threads:'
    end
    object seMaxThreads: TSpinEdit
      Left = 130
      Height = 23
      Top = 42
      Width = 80
      MaxValue = 20
      MinValue = 1
      TabOrder = 1
      Value = 3
    end
    object btnSaveAppConfig: TButton
      Left = 550
      Height = 35
      Top = 12
      Width = 150
      Caption = 'Save Settings'
      TabOrder = 2
      OnClick = btnSaveAppConfigClick
    end
  end
  object gbSmtpList: TGroupBox
    Left = 6
    Height = 335
    Top = 112
    Width = 450
    Align = alLeft
    BorderSpacing.Around = 6
    Caption = ' SMTP List '
    ClientHeight = 315
    ClientWidth = 446
    TabOrder = 1
    object sgSmtp: TStringGrid
      AnchorSideLeft.Control = gbSmtpList
      AnchorSideTop.Control = gbSmtpList
      AnchorSideRight.Control = gbSmtpList
      AnchorSideRight.Side = asrBottom
      AnchorSideBottom.Control = btnAddSmtp
      Left = 5
      Height = 272
      Top = 3
      Width = 438
      Anchors = [akTop, akLeft, akRight, akBottom]
      AutoFillColumns = True
      BorderSpacing.Left = 5
      BorderSpacing.Top = 3
      BorderSpacing.Right = 3
      BorderSpacing.Bottom = 3
      ColCount = 4
      FixedCols = 0
      Options = [goFixedVertLine, goFixedHorzLine, goVertLine, goHorzLine, goRowSelect]
      TabOrder = 0
      OnClick = sgSmtpClick
      ColWidths = (
        110
        110
        109
        109
      )
      Cells = (
        4
        0
        0
        'ID'
        1
        0
        'Host'
        2
        0
        'Username'
        3
        0
        'Status'
      )
    end
    object btnAddSmtp: TButton
      AnchorSideLeft.Control = gbSmtpList
      AnchorSideBottom.Control = gbSmtpList
      AnchorSideBottom.Side = asrBottom
      Left = 4
      Height = 37
      Top = 278
      Width = 100
      Anchors = [akLeft, akBottom]
      BorderSpacing.Left = 4
      Caption = 'Add New'
      TabOrder = 1
      OnClick = btnAddSmtpClick
    end
    object btnDeleteSmtp: TButton
      AnchorSideBottom.Control = gbSmtpList
      AnchorSideBottom.Side = asrBottom
      Left = 120
      Height = 37
      Top = 278
      Width = 100
      Anchors = [akBottom]
      Caption = 'Delete Selected'
      TabOrder = 2
      OnClick = btnDeleteSmtpClick
    end
  end
  object gbSmtpEditor: TGroupBox
    Left = 462
    Height = 335
    Top = 112
    Width = 285
    Align = alClient
    BorderSpacing.Around = 6
    Caption = ' SMTP Editor '
    ClientHeight = 315
    ClientWidth = 281
    TabOrder = 2
    object Label3: TLabel
      Left = 10
      Height = 15
      Top = 15
      Width = 28
      Caption = 'Host:'
    end
    object edtHost: TEdit
      Left = 80
      Height = 23
      Top = 12
      Width = 170
      TabOrder = 0
    end
    object Label4: TLabel
      Left = 10
      Height = 15
      Top = 45
      Width = 25
      Caption = 'Port:'
    end
    object sePort: TSpinEdit
      Left = 80
      Height = 23
      Top = 42
      Width = 80
      MaxValue = 9999
      MinValue = 1
      TabOrder = 1
      Value = 587
    end
    object Label5: TLabel
      Left = 10
      Height = 15
      Top = 75
      Width = 56
      Caption = 'Username:'
    end
    object edtUser: TEdit
      Left = 80
      Height = 23
      Top = 72
      Width = 170
      TabOrder = 2
    end
    object Label6: TLabel
      Left = 10
      Height = 15
      Top = 105
      Width = 53
      Caption = 'Password:'
    end
    object edtPass: TEdit
      Left = 80
      Height = 23
      Top = 102
      Width = 170
      EchoMode = emPassword
      PasswordChar = '*'
      TabOrder = 3
    end
    object Label7: TLabel
      Left = 10
      Height = 15
      Top = 135
      Width = 57
      Caption = 'Limit/Day:'
    end
    object seLimit: TSpinEdit
      Left = 80
      Height = 23
      Top = 132
      Width = 80
      MaxValue = 100000
      MinValue = 1
      TabOrder = 4
      Value = 500
    end
    object Label8: TLabel
      Left = 10
      Height = 15
      Top = 165
      Width = 53
      Caption = 'Delay (ms):'
    end
    object seDelay: TSpinEdit
      Left = 80
      Height = 23
      Top = 162
      Width = 80
      Increment = 1000
      MaxValue = 60000
      MinValue = 1000
      TabOrder = 5
      Value = 15000
    end
    object chkActive: TCheckBox
      Left = 80
      Height = 19
      Top = 195
      Width = 86
      Caption = 'Active / Ready'
      Checked = True
      State = cbChecked
      TabOrder = 6
    end
    object chkWarmup: TCheckBox
      Left = 80
      Height = 19
      Top = 215
      Width = 156
      Caption = 'Auto Warm-Up Mode'
      TabOrder = 7
    end
    object LabelWarmupInfo: TLabel
      Left = 80
      Height = 15
      Top = 235
      Width = 43
      Caption = 'Status: -'
      Font.Color = clGray
      ParentFont = False
    end
    object btnSaveSmtp: TButton
      Left = 5
      Height = 34
      Top = 276
      Width = 271
      Align = alBottom
      Anchors = [akBottom]
      BorderSpacing.Around = 5
      Caption = 'Save SMTP'
      TabOrder = 8
      OnClick = btnSaveSmtpClick
    end
  end
end
